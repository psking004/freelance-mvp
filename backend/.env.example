# Copy to backend/.env for reference; export these in your shell or host dashboard (server.js reads process.env).
PORT=5000
NODE_ENV=development
# Required in production. Long random string used to sign login tokens.
JWT_SECRET=
# Comma-separated allowed origins, e.g. https://your-frontend.example.com (default * = allow all)
CORS_ORIGINS=
# Optional: path to the React build to serve (default ../frontend/build)
FRONTEND_BUILD_DIR=
